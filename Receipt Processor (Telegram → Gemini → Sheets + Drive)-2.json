          "id": "MrP8k8NvDvfHpaZl",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst raw = j.content?.parts?.[0]?.text ?? j.text ?? '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\nlet data = {};\ntry {\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  data = JSON.parse(match ? match[0] : text);\n} catch (e) {\n  data = {};\n}\nreturn {\n  merchant: data.merchant ?? '',\n  amount: data.amount ?? '',\n  date: data.date ?? '',\n  submissionDate: $('Add Submission Date1').item.json.submissionDate,\n};"
      },
