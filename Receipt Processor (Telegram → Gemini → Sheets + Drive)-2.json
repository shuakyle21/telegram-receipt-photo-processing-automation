          "cachedResultName": "models/gemini-3.6-flash"
        },
        "text": "You are a receipt data extractor. Read this receipt image and extract the merchant name, the total amount, and the date printed on the receipt. Respond with ONLY compact JSON, no markdown, in this exact shape: {\"merchant\":\"\",\"amount\":\"\",\"date\":\"\"}. Use an empty string for anything you cannot find.",
        "inputType": "binary",
        "options": {
          "maxOutputTokens": 2048
        }
      },
